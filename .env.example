# ──────────────────────────────────────────────
# Aemy Finance — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production deployment, set these via your hosting platform (e.g. Vercel).

# ─── Supabase ─────────────────────────────────
# Project URL & anon key (find in Supabase Dashboard > Settings > API)
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Used for callback URLs (e.g. OAuth, email links)
VITE_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase Edge Functions ──────────────────
# These are set via `supabase secrets set`, not in .env.local.
# They're listed here for documentation:

# Resend API key for sending partner invitation emails
# RESEND_API_KEY=re_your_resend_key

# Supabase service role key (DO NOT expose to frontend!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
